# Copy to .env (never commit .env). Every key is optional: with none set, the coach runs in mock mode.

# Local server
PORT=8080

# Claude (Anthropic API). Leave blank to disable the Claude adapter.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high  (low keeps the instructor quick)
CLAUDE_EFFORT=low

# OpenAI Realtime voice. The server mints short-lived client secrets; the key never reaches the browser.
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=marin

# Muse: endpoint details still to be supplied (see README, "Adapters").
MUSE_API_URL=
MUSE_API_KEY=

# Offline mode: any OpenAI-compatible local server (Ollama shown).
LOCAL_LLM_URL=http://localhost:11434/v1/chat/completions
LOCAL_LLM_MODEL=qwen3:8b
